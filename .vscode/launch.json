{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Harmonist: depurar biblioteca local",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "pythonArgs": ["-Xfrozen_modules=off"],
      "module": "uvicorn",
      "args": [
        "harmonist.web.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "HARMONIST_DEMO_MODE": "0",
        "HARMONIST_MUSIC_DIR": "/Users/evertonberger/Documents/Tidarr/music",
        "HARMONIST_CONFIG_DIR": "${workspaceFolder}/.dev-data/config",
        "HARMONIST_LOG_LEVEL": "debug",
        "HARMONIST_ALLOWED_HOSTS": "localhost,127.0.0.1"
      },
      "jinja": true,
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Harmonist: depurar demo",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "pythonArgs": ["-Xfrozen_modules=off"],
      "module": "uvicorn",
      "args": [
        "harmonist.web.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "HARMONIST_DEMO_MODE": "1",
        "HARMONIST_CONFIG_DIR": "${workspaceFolder}/.dev-data/demo-config",
        "HARMONIST_LOG_LEVEL": "debug",
        "HARMONIST_ALLOWED_HOSTS": "localhost,127.0.0.1"
      },
      "jinja": true,
      "justMyCode": true,
      "console": "integratedTerminal"
    }
  ]
}
